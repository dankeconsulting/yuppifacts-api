# Configure production values only in the Render service. Never commit credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
WEB_ORIGIN=https://yuppifacts.com,https://app.yuppifacts.com,https://admin.yuppifacts.com,https://tickets.yuppifacts.com,https://promo.yuppifacts.com
API_PUBLIC_URL=https://yuppifacts-api.onrender.com
APP_ENV=production
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-unique-random-secret
MASTER_ADMIN_EMAIL=admin@your-domain.example
APP_SECRET=replace-with-a-unique-random-secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=yuppifacts-private-documents
AWS_S3_PROMOTION_PREFIX=dankeconsulting/yuppifacts/promotions/vouchers
AWS_KMS_KEY_ID=
# New YuppiFacts documents use private Cloudflare R2 when all four values below
# are present. Existing AWS S3 objects keep using their stored legacy key.
# Use a production token restricted to the yuppifacts-production bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=yuppifacts-production
R2_PREFIX=yuppifacts
AWS_SES_FROM_EMAIL=notificaciones@dankeconsulting.com
PROMO_REPLY_TO_EMAIL=promo@yuppifacts.com
