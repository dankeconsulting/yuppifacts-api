# Configure these values only in the Render service for yuppifacts-api.
# Never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
WEB_ORIGIN=https://yuppifacts.com,https://app.yuppifacts.com,https://admin.yuppifacts.com
ADMIN_REVIEW_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# 32-byte base64 secret, dedicated to YuppiFacts. Generate and store only in Render.
CREDENTIAL_ENCRYPTION_KEY=
# Bootstrap PIN for the first administrative configuration. It may be replaced through the protected UI.
ADMIN_CONFIG_PIN=

# AWS resources used exclusively by the API to create encrypted private uploads.
AWS_REGION=us-east-1
AWS_S3_BUCKET=yuppifacts-private-documents
AWS_KMS_KEY_ID=
AWS_SES_FROM_EMAIL=notificaciones@your-domain.example
