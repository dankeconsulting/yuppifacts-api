# Configure these values only in the Render service for yuppifacts-api.
# Never commit actual credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
WEB_ORIGIN=https://yuppifacts.com,https://app.yuppifacts.com,https://admin.yuppifacts.com
APP_ENV=production
# One-use secret for /v1/bootstrap/master-administrator. Configure it only in Render.
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-unique-random-secret
MASTER_ADMIN_EMAIL=admin@your-domain.example
APP_SECRET=replace-with-a-unique-random-secret

# AWS resources used exclusively by the API to create encrypted private uploads.
AWS_REGION=us-east-1
AWS_S3_BUCKET=yuppifacts-private-documents
AWS_KMS_KEY_ID=
AWS_SES_FROM_EMAIL=notificaciones@your-domain.example
